# Copy this file to .env. Never commit .env or paste credentials in chat.
# Any provider exposing /v1/chat/completions with the configured model is supported.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=60

# Feishu enterprise custom application (机器人)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: table columns all use plain text: 任务 / 成员 / 状态 / 成果ID / 内容
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
